<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings come from api/Directory.Build.props -->

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Email copy is Spanish prose; kept out of .cs literals (CP1252 source
         gotcha) and read as UTF-8 at runtime - see PasswordResetEmail. -->
    <EmbeddedResource Include="Infrastructure\Email\Templates\*" LogicalName="EmailTemplates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with BookingEngine.Worker (same DB, no migrations there — see
         BookingEngine.Infrastructure's own comment). -->
    <ProjectReference Include="..\BookingEngine.Domain\BookingEngine.Domain.csproj" />
    <ProjectReference Include="..\BookingEngine.Infrastructure\BookingEngine.Infrastructure.csproj" />
  </ItemGroup>

</Project>
