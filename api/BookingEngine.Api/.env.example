# ASP.NET Core reads these as environment variables; "__" (double underscore)
# maps to nested config keys (ConnectionStrings__Default -> ConnectionStrings:Default).

# Postgres connection string (Neon). Use a dev branch, not main — see root README.
# Neon's dashboard gives you a postgresql:// URI — Npgsql (the .NET driver)
# does NOT parse that format, it needs classic keyword=value pairs:
#   Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=Require
ConnectionStrings__Default=

# CORS origin for the deployed web frontend. Empty in local dev.
FRONTEND_WEB_URL=

# Global fixed-window rate limit, requests per client IP per minute. Defaults
# to 100. Set it high for the e2e suite (every test hits the API from one IP);
# leave it unset in production.
RATE_LIMIT_PER_MINUTE=

# HMAC key for signing our first-party session tokens (access + refresh). A
# dev fallback is baked in, so this is optional locally; set it in production.
AUTH_TOKEN_SECRET=

# Accepted Google OAuth 2.0 client IDs — the ID token's `aud` must be one of
# these. Comma-separated (web, iOS, Android). Leave empty to skip the audience
# check (dev only). Create them at console.cloud.google.com -> Credentials.
GOOGLE_CLIENT_ID=

# Google Calendar integration ("Anadir a Google Calendar" on the Confirmed
# screen). A SEPARATE OAuth2 flow from sign-in — the calendar.events scope +
# a refresh token, exchanged/refreshed server-side. Needs the *web* OAuth
# client's id + secret. Also add the web app origin (http://localhost:8081 in
# dev) to that client's "Authorized redirect URIs" in Google Cloud. Both empty
# -> /calendar/* return 503 and the app keeps the device-calendar / clipboard
# fallback.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side Google Maps key with the *Geocoding API* enabled. Restrict it by
# *IP* (the API host), NOT by HTTP referrer — the Geocoding web service ignores
# referrer restrictions. Used only by the /geocode/reverse proxy for the owner
# map picker. Unset -> the proxy returns { "address": null } and the picker
# falls back to manual address entry. This is NOT EXPO_PUBLIC_* and never ships
# to the client.
GOOGLE_MAPS_SERVER_KEY=

# Space-photo uploads -> a Google Cloud Storage bucket via V4 signed PUT URLs.
# GCS_BUCKET plus a working signer must be set, or the four
# /owner/spaces/{id}/images endpoints return 503 and the app's photo section is
# disabled.
#   GCS_BUCKET                 = the bucket name (no gs:// prefix)
#   GCS_SIGNER_SERVICE_ACCOUNT = the signer SA's email (has
#                                roles/storage.objectAdmin on the bucket).
#                                PREFERRED — no key file. V4 URLs are signed
#                                through the IAM Credentials API (signBlob):
#                                - Local dev: keep this set. Application Default
#                                  Credentials (`gcloud auth application-default
#                                  login`) impersonate it, so your user needs
#                                  roles/iam.serviceAccountTokenCreator on the SA
#                                  and the IAM Credentials API enabled
#                                  (`gcloud services enable iamcredentials.googleapis.com`).
#                                - Deployed with that SA attached: leave this
#                                  unset, ADC already *is* the signer.
#   GCS_CREDENTIALS_PATH        = legacy fallback: path to a downloaded SA key
#                                JSON. Keep it outside git (api/.secrets/ is
#                                gitignored). Only where an org policy allows key
#                                creation. e.g. GCS_CREDENTIALS_PATH=.secrets/gcs-key.json
#   GCS_CREDENTIALS_JSON        = the same JSON inline, on ONE line. Deploy envs
#                                that can't hold a file and can't use ADC.
# Bucket setup: uniform bucket-level access; grant allUsers
# roles/storage.objectViewer (objects are public, names are unguessable GUIDs);
# set CORS to allow PUT+GET from http://localhost:8081 (+ the prod origin):
#   gcloud storage buckets update gs://<bucket> --cors-file=cors.json
GCS_BUCKET=
GCS_SIGNER_SERVICE_ACCOUNT=
GCS_CREDENTIALS_PATH=
GCS_CREDENTIALS_JSON=
