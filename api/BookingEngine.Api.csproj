<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.71.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with BookingEngine.Worker (same DB, no migrations there — see
         BookingEngine.Infrastructure's own comment). -->
    <ProjectReference Include="BookingEngine.Domain\BookingEngine.Domain.csproj" />
    <ProjectReference Include="BookingEngine.Infrastructure\BookingEngine.Infrastructure.csproj" />
  </ItemGroup>

  <!-- BookingEngine.Api.Tests, BookingEngine.Domain, BookingEngine.Infrastructure
       and BookingEngine.Worker all nest inside this project's directory;
       without this, the default **/*.cs glob would compile their files into
       this project too. -->
  <ItemGroup>
    <Compile Remove="BookingEngine.Api.Tests/**/*.cs" />
    <Compile Remove="BookingEngine.Domain/**/*.cs" />
    <Compile Remove="BookingEngine.Infrastructure/**/*.cs" />
    <Compile Remove="BookingEngine.Worker/**/*.cs" />
  </ItemGroup>

</Project>
