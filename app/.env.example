# Required for production builds (all platforms).
#
# In development it's optional and, when set, overrides the per-platform
# defaults in src/lib/config.ts (localhost / 10.0.2.2). Set it to your
# machine's LAN IP when testing on a physical phone over Expo Go, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:5190
# and run the API with: dotnet run --launch-profile lan   (binds 0.0.0.0)
EXPO_PUBLIC_API_URL=

# Google OAuth 2.0 client IDs, from console.cloud.google.com -> Credentials.
# Create one per platform. Web is enough to sign in from the web build; the
# native ones are needed for the iOS/Android redirect. When none are set, the
# sign-in screen falls back to the dev magic-link entry (Development only).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
